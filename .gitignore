# ============================================================
# Vaultis — .gitignore
# Author: Sambhav Dwivedi
# ============================================================

# ── Rust / Cargo ─────────────────────────────────────────────
src-tauri/target/
src-tauri/.cargo-lock

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Vite build output ────────────────────────────────────────
dist/
dist-ssr/
*.local
Vaultis

src-tauri/icons
txt
tauri-info.txt
FRONTEND_IMPLEMENTATION_GUIDE.md
COMPLETE_FILE_TREE.md
COMPLETE_FILE_INVENTORY.md

# ── Tauri build output ───────────────────────────────────────
src-tauri/target/
src-tauri/WixTools/

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# ── Vault data (NEVER commit user data) ──────────────────────
*.vaultis
*.valts
vault.meta
vaultis.db
vaultis.db-wal
vaultis.db-shm
/data/
/backups/
/files/

# ── OS generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Test artifacts ───────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Temp files ───────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
manifest_tmp.json
restore_staging/

# ── TypeScript (if added later) ──────────────────────────────
*.tsbuildinfo

# ── Package lock (keep only one) ─────────────────────────────
# Uncomment whichever you don't use:
# package-lock.json
# yarn.lock